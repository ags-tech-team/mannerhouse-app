{
  "name": "mannerhouse-api",
  "version": "1.0.0",
  "description": "API para sistema de barbearia Manner House",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:sqlite": "NODE_ENV=development nodemon server.js",
    "seed": "node src/seeders/seed.js",
    "cli": "node src/cli.js",
    "setup": "node src/quick-setup.js",
    "db:reset": "node -e \"const fs = require('fs'); try { fs.unlinkSync('./database.sqlite'); console.log('✅ Banco resetado'); } catch(e) { console.log('ℹ️ Nenhum banco para resetar'); }\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}